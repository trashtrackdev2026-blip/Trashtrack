# Browser configuration: use this project's Firebase Web app settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server secrets: add as sensitive variables in Vercel, never NEXT_PUBLIC_.
# Paste the Firebase Admin service-account JSON as the value, not a Windows path.
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=

# Copy the currently active, validated UUIDs from the local configuration.
# Both must pin the same deployed Firestore policy. Never invent new UUIDs.
STAFF_SECURITY_RULESET=
CERTIFICATE_SECURITY_RULESET=

# Vercel terminates HTTPS at its managed proxy.
TRUST_TLS_PROXY=true

# LOCAL DEVELOPMENT ONLY: an existing service-account file may be used instead.
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/service-account.json
