{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/patch-jwks-rsa.mjs",
    "dev": "next dev -H 0.0.0.0 --webpack",
    "build": "next build --webpack",
    "build:vercel": "npm run check:runtime && npm run check:deployment -- --vercel && npm run build && npm run check:bundle",
    "check:runtime": "node --test tests/firebase-runtime.test.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "prepare:vercel": "node scripts/prepare-vercel-env.mjs",
    "check:bundle": "node scripts/check-deployment-bundle.mjs",
    "package:vercel": "powershell -NoProfile -File scripts/package-vercel.ps1",
    "check:launch": "npm run check:deployment && npm test && npm run build && npm run check:bundle",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.12.0",
